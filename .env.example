DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=mysql
DB_NAME=routedb
DB_USER=route_user
DB_PASSWORD=replace-with-your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60
FIREBASE_CREDENTIALS=path/to/server-only/firebase-service-account.json
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
PROFILE_IMAGE_MAX_BYTES=5242880
MAX_REQUEST_BODY_BYTES=6291456
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=0
DJANGO_TRUST_X_FORWARDED_PROTO=false
API_ANON_RATE=60/min
API_USER_RATE=240/min
